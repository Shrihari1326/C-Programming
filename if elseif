
#include <stdio.h>

int main()
{
    int s1, s2, s3, s4, s5;
    float total, percentage;

    printf("Enter marks of 5 subjects: ");
    scanf("%d %d %d %d %d",
          &s1, &s2, &s3, &s4, &s5);

    if (s1 > 100 || s2 > 100 || s3 > 100 ||
        s4 > 100 || s5 > 100 ||
        s1 < 0 || s2 < 0 || s3 < 0 ||
        s4 < 0 || s5 < 0)
    {
        printf("Invalid Marks!");
    }
    else
    {
        total = s1 + s2 + s3 + s4 + s5;
        percentage = total / 5;

        printf("\nTotal Marks = %.2f", total);
        printf("\nPercentage = %.2f%%", percentage);

        if (s1 < 35 || s2 < 35 || s3 < 35 ||
            s4 < 35 || s5 < 35)
        {
            printf("\nResult: FAIL");
        }
        else if (percentage >= 90)
        {
            printf("\nGrade: A+");
            printf("\nResult: PASS");
        }
        else if (percentage >= 80)
        {
            printf("\nGrade: A");
            printf("\nResult: PASS");
        }
        else if (percentage >= 70)
        {
            printf("\nGrade: B");
            printf("\nResult: PASS");
        }
        else if (percentage >= 60)
        {
            printf("\nGrade: C");
            printf("\nResult: PASS");
        }
        else if (percentage >= 50)
        {
            printf("\nGrade: D");
            printf("\nResult: PASS");
        }
        else
        {
            printf("\nGrade: E");
            printf("\nResult: PASS");
        }
    }

    return 0;
}
