#include <stdio.h>

void calibrate(float data, int size, float offset) {
    for (int i = 0; i < size; i++) {
        *(data + i) += offset;   // changes the original array
    }
}

int main() {
    float sensor[5] = {25.5, 26.1, 24.8, 27.3, 25.9};

    calibrate(sensor, 5, -0.5);   // pass by reference

    for (int i = 0; i < 5; i++) {
        printf("%.1f ", sensor[i]);
    }

    return 0;
}
